{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TetPlayer",
  "version": "1.2.0",
  "identifier": "com.tetplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TetPlayer",
        "width": 1050,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
