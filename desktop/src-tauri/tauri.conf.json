{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TetPlayer",
  "version": "2.0.0",
  "identifier": "com.tetplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TetPlayer",
        "width": 1050,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["Portuguese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGRThDOUM3M0Q0RUM3NEIKUldSTHgwNDl4OG5vMy9VcXpENGlxNHBBSWZwek9NN2g2b3N0ODUwM0FERzlZS21oYkVGUzhwaHIK",
      "endpoints": [
        "https://github.com/p0pes/TetPlayer/releases/latest/download/latest.json"
      ]
    }
  }
}
